rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function loggedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return loggedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsTo(companyId, officeId) {
      return hasProfile()
        && profile().companyId == companyId
        && profile().officeId == officeId;
    }

    function isAdmin(companyId, officeId) {
      return belongsTo(companyId, officeId)
        && profile().role == "admin";
    }

    function isDriver(companyId, officeId) {
      return belongsTo(companyId, officeId)
        && profile().role == "driver";
    }

    function hasDriverProfileFields() {
      return request.resource.data.keys().hasAll([
               "role",
               "companyId",
               "officeId",
               "displayName",
               "loginId",
               "approvedAt"
             ])
             && request.resource.data.keys().hasOnly([
               "role",
               "companyId",
               "officeId",
               "displayName",
               "loginId",
               "approvedAt"
             ])
             && request.resource.data.role == "driver";
    }

    function hasPendingRegistration(companyId, officeId, userId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)/offices/$(officeId)/registrationRequests/$(userId))
             && get(/databases/$(database)/documents/companies/$(companyId)/offices/$(officeId)/registrationRequests/$(userId)).data.status == "pending";
    }

    // ========================================
    // 会社
    // ========================================
    match /companies/{companyId} {

      // お試し登録した本人だけ、
      // trial-自分のUID の会社を新規作成できる
      allow create: if loggedIn()
                    && companyId == "trial-" + request.auth.uid
                    && request.resource.data.isTrial == true
                    && request.resource.data.vehicleLimit == 5;

      // 自分が所属する会社の基本情報を読む
      allow read: if hasProfile()
                  && profile().companyId == companyId;

      // 会社情報の変更・削除は現時点では禁止
      allow update, delete: if false;
    }

    // ========================================
    // ユーザー
    // ========================================
    match /users/{userId} {

      // 自分自身のプロフィールを読む
      allow read: if loggedIn()
                  && request.auth.uid == userId;

      // お試し登録時の最初の管理者プロフィール作成
      allow create: if (
                 loggedIn()
                 && request.auth.uid == userId
                 && request.resource.data.companyId
                   == "trial-" + request.auth.uid
                 && request.resource.data.officeId == "main"
                 && request.resource.data.role == "admin"
                 && request.resource.data.isTrial == true
                ) || (
                 loggedIn()
                 && request.auth.uid != userId
                 && isAdmin(request.resource.data.companyId,
                        request.resource.data.officeId)
                 && hasDriverProfileFields()
                 && hasPendingRegistration(request.resource.data.companyId,
                                  request.resource.data.officeId,
                                  userId)
                 && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/offices/$(request.resource.data.officeId)/registrationRequests/$(userId)).data.role
                   == "driver"
                 && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/offices/$(request.resource.data.officeId)/registrationRequests/$(userId)).data.companyId
                   == request.resource.data.companyId
                 && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/offices/$(request.resource.data.officeId)/registrationRequests/$(userId)).data.officeId
                   == request.resource.data.officeId
                 && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/offices/$(request.resource.data.officeId)/registrationRequests/$(userId)).data.status
                   == "approved"
                );

      // 現時点ではプロフィール変更・削除は禁止
      allow update, delete: if false;
    }

    // ========================================
    // QRからの運転者登録申請
    // ========================================
    match /companies/{companyId}/offices/{officeId}/registrationRequests/{userId} {

      allow create: if loggedIn()
                    && request.auth.uid == userId
                    && exists(/databases/$(database)/documents/companies/$(companyId))
                    && exists(/databases/$(database)/documents/companies/$(companyId)/offices/$(officeId))
                    && request.resource.data.companyId == companyId
                    && request.resource.data.officeId == officeId
                    && request.resource.data.role == "driver"
                    && request.resource.data.status == "pending"
                    && request.resource.data.keys().hasOnly([
                      "displayName",
                      "loginId",
                      "role",
                      "companyId",
                      "officeId",
                      "status",
                      "createdAt"
                    ]);

      allow read: if (loggedIn() && request.auth.uid == userId)
                  || isAdmin(companyId, officeId);

      allow update: if isAdmin(companyId, officeId)
                    && resource.data.status == "pending"
                    && (
                      (
                        request.resource.data.status == "approved"
                        && request.resource.data.keys().hasAll(["status", "approvedAt", "approvedBy"])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approvedAt", "approvedBy"])
                        && request.resource.data.approvedBy == request.auth.uid
                        && !exists(/databases/$(database)/documents/users/$(userId))
                        && existsAfter(/databases/$(database)/documents/users/$(userId))
                        && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == "driver"
                        && getAfter(/databases/$(database)/documents/users/$(userId)).data.companyId == companyId
                        && getAfter(/databases/$(database)/documents/users/$(userId)).data.officeId == officeId
                      )
                      ||
                      (
                        request.resource.data.status == "rejected"
                        && request.resource.data.keys().hasAll(["status", "rejectedAt", "rejectedBy"])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "rejectedAt", "rejectedBy"])
                        && request.resource.data.rejectedBy == request.auth.uid
                      )
                    );

      allow delete: if false;
    }

    // ========================================
    // 点検記録
    // ========================================
    match /companies/{companyId}/offices/{officeId}/inspections/{inspectionId} {

      allow create: if (
                      isAdmin(companyId, officeId)
                      || isDriver(companyId, officeId)
                    )
                    && request.resource.data.companyId == companyId
                    && request.resource.data.officeId == officeId
                    && request.resource.data.keys().hasOnly([
                      "id",
                      "date",
                      "vehicle",
                      "driver",
                      "shaken",
                      "shakenConfirmed",
                      "managerConfirmedBy",
                      "managerConfirmedRole",
                      "results",
                      "overall",
                      "abnormal",
                      "previous",
                      "today",
                      "driverChange",
                      "previousDriverReport",
                      "savedAt",
                      "companyId",
                      "officeId",
                      "cloudUpdatedAt"
                    ]);

      allow read, update, delete: if isAdmin(companyId, officeId);
    }

    // ========================================
    // 車両
    // ========================================
    match /companies/{companyId}/offices/{officeId}/vehicles/{vehicleId} {

      allow read: if belongsTo(companyId, officeId);

      allow create, update, delete: if isAdmin(companyId, officeId);
    }

    // ========================================
    // 設定
    // ========================================
    match /companies/{companyId}/offices/{officeId}/settings/{settingId} {

      allow read: if belongsTo(companyId, officeId);

      allow create, update, delete: if isAdmin(companyId, officeId);
    }
  }
}